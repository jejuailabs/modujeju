# Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials; never prefix with NEXT_PUBLIC_
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Explicit opt-in only after reviewing provider costs and receiving approval.
CLOUD_SERVICES_ENABLED=false
NEXT_PUBLIC_CLOUD_SERVICES_ENABLED=false
NEXT_PUBLIC_SITE_URL=

# Official observed listings are the default. Fictional fixtures require explicit opt-in.
DEMO_MODE=false

# VisitJeju: configure only after usage approval and confirmation of the HTTPS contract.
VISITJEJU_API_ENABLED=false
VISITJEJU_USAGE_APPROVED=false
VISITJEJU_API_KEY=
VISITJEJU_API_URL=
# Confirm the provider's expected spelling: apiKey or apikey.
VISITJEJU_API_KEY_PARAM=

