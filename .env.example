# Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials; never prefix with NEXT_PUBLIC_
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Explicit opt-in only after reviewing provider costs and receiving approval.
CLOUD_SERVICES_ENABLED=false
NEXT_PUBLIC_CLOUD_SERVICES_ENABLED=false
NEXT_PUBLIC_SITE_URL=

# Official observed listings are the default. Fictional fixtures require explicit opt-in.
DEMO_MODE=false

# VisitJeju's working query parameter is case-sensitive. Keep the issued key server-side.
VISITJEJU_API_ENABLED=false
VISITJEJU_USAGE_APPROVED=false
VISITJEJU_API_KEY=
VISITJEJU_API_URL=https://api.visitjeju.net/vsjApi/contents/searchList
VISITJEJU_API_KEY_PARAM=apiKey

# Recurring ingestion stays inactive until explicit approval of this scope and duration.
# These flags do not constitute approval. Confirm provider, hosting, database and storage costs.
VISITJEJU_SYNC_ENABLED=false
VISITJEJU_SYNC_COST_APPROVED=false
VISITJEJU_STORAGE_APPROVED=false
# One-time local snapshot only: explicit expiry and 1–100 request budget, no cloud required.
# Set approvals only after the user approves provider terms and this exact scope.
VISITJEJU_LOCAL_APPROVAL_EXPIRES_AT=
VISITJEJU_LOCAL_START_PAGE=1
VISITJEJU_LOCAL_MAX_PAGES=1
# Required future UTC ISO timestamp; empty or expired values block the scheduled route.
VISITJEJU_SYNC_APPROVAL_EXPIRES_AT=
# Lower values are allowed; increasing beyond 2 pages / 100 items requires code review.
VISITJEJU_SYNC_MAX_PAGES=2
VISITJEJU_SYNC_MAX_ITEMS=100
# Server-only random secret, at least 32 URL-safe characters; never put a real value here.
CRON_SECRET=

