rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    match /places/{id} { allow read, write: if false; }
    match /reports/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }
    match /users/{uid} {
      allow read: if own(uid);
      allow write: if false;
      match /saved/{placeId} {
        allow read, delete: if own(uid);
        allow create, update: if own(uid)
          && request.resource.data.keys().hasAll(['placeId', 'savedAt', 'snapshotUpdatedAt'])
          && request.resource.data.keys().hasOnly(['placeId', 'savedAt', 'snapshotUpdatedAt'])
          && request.resource.data.placeId == placeId
          && request.resource.data.placeId is string
          && request.resource.data.placeId.size() <= 100
          && request.resource.data.savedAt is timestamp
          && request.resource.data.savedAt == request.time
          && request.resource.data.snapshotUpdatedAt is string
          && request.resource.data.snapshotUpdatedAt.size() <= 40
          && exists(/databases/$(database)/documents/places/$(placeId))
          && get(/databases/$(database)/documents/places/$(placeId)).data.status == 'published';
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
